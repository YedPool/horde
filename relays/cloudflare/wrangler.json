{
  "name": "relay",
  "main": "worker/index.js",
  "base_dir": "../..",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "upload_source_maps": false,
  "observability": { "enabled": false },
  "vars": {
    "HORDE_RELAY_ORIGIN": "https://relay.yedidyapool.workers.dev",
    "HORDE_RELAY_GOOGLE_CALLBACK": "/auth/google/callback"
  },
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MAILBOX", "class_name": "Mailbox" },
      { "name": "SESSION", "class_name": "Session" },
      { "name": "ACCOUNT", "class_name": "Account" },
      { "name": "MACHINE_KEY", "class_name": "MachineKey" },
      { "name": "ADDRESS", "class_name": "Address" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Mailbox"] },
    { "tag": "v2", "new_sqlite_classes": ["Session", "Account", "MachineKey"] },
    { "tag": "v3", "new_sqlite_classes": ["Address"] }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }]
}
