# Mutations of core/AgentDescriptor.ps1 (engines E2).
# Run: powershell -File tools\Mutate.ps1 -Spec test\mutations\agent-descriptor.psd1
# Each breaks one rule the strict loader exists for; test\test-agent-descriptor.ps1 must fail for every one.
@{
    Target = "core\AgentDescriptor.ps1"
    Suite  = "test\test-agent-descriptor.ps1"
    Environment = @{ HORDE_FAIL_FAST = "1" }
    Mutations = @(
        @{ Name = "empty-list-read-as-missing"
           Find = 'Write-Output -NoEnumerate $p.Value'
           Replace = 'return $p.Value' }
        @{ Name = "bom-accepted"
           Find = '$Bytes[2] -eq 0xBF) { throw'
           Replace = '$Bytes[2] -eq 0x00) { throw' }
        @{ Name = "non-ascii-accepted"
           Find = 'if ($b -gt 0x7F) { throw'
           Replace = 'if ($b -gt 0xFF) { throw' }
        @{ Name = "duplicate-key-ignored"
           Find = 'return @(@(& $script:HordeAgentDuplicateKeyScan -Text $Text) |'
           Replace = 'return @(@() |' }
        @{ Name = "duplicate-scan-shape-assumed"
           Find = 'Where-Object { $null -ne $_ } | ForEach-Object { "a key appears twice'
           Replace = 'Where-Object { "$_" -like "*appears more than once*" } | ForEach-Object { "a key appears twice' }
        @{ Name = "duplicate-scan-looked-up-by-name"
           Find = 'return @(@(& $script:HordeAgentDuplicateKeyScan -Text $Text) |'
           Replace = 'return @(@(Find-HordeJsonDuplicateKey -Text $Text) |' }
        @{ Name = "permission-precondition-ignored"
           Find = 'if (@($Verified) -cnotcontains "$($c.name)") {'
           Replace = 'if ($false) {' }
        @{ Name = "permission-precondition-matched-ignoring-case"
           Find = 'if (@($Verified) -cnotcontains "$($c.name)") {'
           Replace = 'if (@($Verified) -notcontains "$($c.name)") {' }
        @{ Name = "permission-entry-point-ignored"
           Find = 'if (@($entries) -cnotcontains $EntryPoint) {'
           Replace = 'if ($false) {' }
        @{ Name = "permission-entry-points-not-required"
           Find = 'if ($null -eq $entries -or ($entries -is [System.Array] -and @($entries).Count -eq 0)) {'
           Replace = 'if ($false) {' }
        @{ Name = "permission-entry-point-repeat-accepted"
           Find = 'if (-not $seenEntry.Add("$e"))'
           Replace = 'if ($false)' }
        @{ Name = "permission-readback-not-required"
           Find = 'if ($null -eq (Get-HordeAgentProp $row "readback")) {'
           Replace = 'if ($false) {' }
        @{ Name = "permission-inexpressible-may-carry-extras"
           Find = 'foreach ($k in @("entryPoints", "readback", "preconditions")) {'
           Replace = 'foreach ($k in @()) {' }
        @{ Name = "permission-precondition-repeat-accepted"
           Find = 'if ($cn -is [string] -and -not $seenPre.Add($cn))'
           Replace = 'if ($false)' }
        @{ Name = "no-agents-folder-is-empty-success"
           Find = 'return (New-HordeAbsent -Note ("there is no agents folder under " + $Root))'
           Replace = 'return (New-HordeKnown -Value $out)' }
        @{ Name = "schema-skipped"
           Find = '@(Test-HordeSchema -Value $d -Schema (Get-HordeSchema -Name "agent-descriptor.v1"))'
           Replace = '@()' }
        @{ Name = "name-not-checked-against-folder"
           Find = '$name -cne $ExpectedName'
           Replace = '$false' }
        @{ Name = "empty-protocols-accepted"
           Find = 'if (@($protocols).Count -eq 0) {'
           Replace = 'if ($false) {' }
        @{ Name = "repeated-protocol-accepted"
           Find = 'if (-not $seenP.Add("$p"))'
           Replace = 'if ($false)' }
        @{ Name = "unanchored-pattern-accepted"
           Find = 'if ($compiled -and -not ($startsAnchored -and $endsAnchored))'
           Replace = 'if ($false)' }
        @{ Name = "start-anchor-enough"
           Find = '-not ($startsAnchored -and $endsAnchored)'
           Replace = '-not ($startsAnchored)' }
        @{ Name = "compile-failure-unnamed"
           Find = '"the sessionIdPattern does not compile: " + $_.Exception.InnerException.Message'
           Replace = '"bad pattern"' }
        @{ Name = "owned-variables-compared-with-case"
           Find = '[System.StringComparer]::OrdinalIgnoreCase)'
           Replace = '[System.StringComparer]::Ordinal)' }
        @{ Name = "supported-event-needs-no-hook"
           Find = '-and $hook -isnot [string]) {'
           Replace = '-and $false) {' }
        @{ Name = "lacking-event-may-name-hook"
           Find = 'if ($null -ne $hook) { [void]$out.Add("the event "'
           Replace = 'if ($false) { [void]$out.Add("the event "' }
        @{ Name = "capability-list-not-compared-with-vocabulary"
           Find = 'foreach ($w in $want) { if ($have -cnotcontains $w)'
           Replace = 'foreach ($w in @()) { if ($have -cnotcontains $w)'
           Expect = "survives"
           Reason = "Defence in depth: the schema lists the same capability names as required, and test-agent-descriptor checks the schema's list equals the vocabulary's, so while both agree the schema refuses first. The rule exists for the day one of them changes alone." }
        @{ Name = "missing-folder-descriptor-ignored"
           Find = '[void]$problems.Add("the harness folder " + $dir.Name + " has no agent.json"); continue'
           Replace = 'continue' }
        @{ Name = "bad-descriptor-dropped-from-list"
           Find = 'catch { [void]$problems.Add($_.Exception.Message) }'
           Replace = 'catch { }' }
        @{ Name = "unverified-satisfies-requirement"
           Find = 'return [bool]("$($row.support)" -ceq "yes")'
           Replace = 'return [bool]("$($row.support)" -cne "no")' }
        @{ Name = "unverified-answered-plain-no"
           Find = 'return (New-HordeUnknown -Reason ($Name + " is unverified for "'
           Replace = 'return (New-HordeKnown -Value $false); return (New-HordeUnknown -Reason ($Name + " is unverified for "' }
        @{ Name = "unverified-answered-yes"
           Find = 'if ($support -ceq "yes") { return (New-HordeKnown -Value $true) }'
           Replace = 'if ($support -ceq "yes" -or $support -ceq "unverified") { return (New-HordeKnown -Value $true) }' }
        @{ Name = "declined-answered-unknown"
           Find = 'if ($support -ceq "no" -or $support -ceq "declined")'
           Replace = 'if ($support -ceq "no")' }
        @{ Name = "permission-nearest-lower-level"
           Find = 'if ($null -ne $why) { return (New-HordeUnknown -Reason ($who + " cannot express the permission level "'
           Replace = 'if ($null -ne $why) { $lv = @($Levels); $i = $rank.value - 1; while ($i -ge 0) { $r2 = @(@($rows) | Where-Object { (Get-HordeAgentProp $_ "level") -ceq $lv[$i].name -and $null -eq (Get-HordeAgentProp $_ "inexpressible") }); if ($r2.Count -eq 1) { $a2 = Get-HordeAgentProp $r2[0] "argv"; return (New-HordeKnown -Value ([string[]]@(@($a2) | ForEach-Object { "$_" }))) }; $i-- } }; if ($null -ne $why) { return (New-HordeUnknown -Reason ($who + " cannot express the permission level "' }
        @{ Name = "permission-inexpressible-answered-empty"
           Find = 'if ($null -ne $why) { return (New-HordeUnknown -Reason ($who + " cannot express the permission level "'
           Replace = 'if ($null -ne $why) { return (New-HordeKnown -Value ([string[]]@())) }; if ($false) { return (New-HordeUnknown -Reason ($who + " cannot express the permission level "' }
        @{ Name = "permission-level-name-not-checked"
           Find = 'if ($rank.state -cne "known") { return (New-HordeUnknown -Reason $rank.reason) }'
           Replace = '' }
        @{ Name = "permission-fragment-shared"
           Find = '[string[]]@(@($argv) | ForEach-Object { "$_" })'
           Replace = '$argv' }
        @{ Name = "permission-both-accepted"
           Find = 'if ($null -ne $argv -and $null -ne $why) {'
           Replace = 'if ($false) {' }
        @{ Name = "permission-neither-accepted"
           Find = 'elseif ($null -eq $argv -and $null -eq $why) {'
           Replace = 'elseif ($false) {' }
        @{ Name = "permission-empty-fragment-accepted"
           Find = '-and @($argv).Count -eq 0) {'
           Replace = '-and $false) {' }
        @{ Name = "permission-fragment-without-evidence"
           Find = 'if ($null -eq $ev) { [void]$out.Add("the permission level "'
           Replace = 'if ($false) { [void]$out.Add("the permission level "' }
        @{ Name = "permission-inexpressible-with-evidence"
           Find = 'elseif ($null -ne $ev) { [void]$out.Add("the permission level "'
           Replace = 'elseif ($false) { [void]$out.Add("the permission level "' }
        @{ Name = "permission-missing-level-ignored"
           Find = 'foreach ($m in @($cov.missing))'
           Replace = 'foreach ($m in @())' }
        @{ Name = "permission-unknown-level-ignored"
           Find = 'foreach ($u in @($cov.unknown))'
           Replace = 'foreach ($u in @())' }
        @{ Name = "permission-repeated-level-ignored"
           Find = 'foreach ($t in @($cov.duplicate))'
           Replace = 'foreach ($t in @())' }
        @{ Name = "vocabulary-host-not-checked"
           Find = '$script:HordeHostCapabilityNames -cnotcontains $hostName'
           Replace = '$false' }
        @{ Name = "vocabulary-repeat-accepted"
           Find = 'elseif (-not $seen.Add($name))'
           Replace = 'elseif ($false)' }
        @{ Name = "vocabulary-port-not-checked"
           Find = '$script:HordeCapabilityPorts -cnotcontains $port'
           Replace = '$false' }
        @{ Name = "vocabulary-agent-row-may-name-host"
           Find = 'if ($null -ne $hostName) { [void]$problems.Add($at + " is satisfied only by an agent'
           Replace = 'if ($false) { [void]$problems.Add($at + " is satisfied only by an agent' }
        @{ Name = "vocabulary-flag-in-meaning-accepted"
           Find = 'elseif ($meaning -cmatch $script:HordeCapabilityFlagPattern)'
           Replace = 'elseif ($false)' }
    )
}
