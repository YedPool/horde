# Mutations of core/AgentDescriptor.ps1 (engines E2).
# Run: powershell -File tools\Mutate.ps1 -Spec test\mutations\agent-descriptor.psd1
# Each breaks one rule the strict loader exists for; test\test-agent-descriptor.ps1 must fail for every one.
@{
    Target = "core\AgentDescriptor.ps1"
    Suite  = "test\test-agent-descriptor.ps1"
    Environment = @{ HORDE_FAIL_FAST = "1" }
    Mutations = @(
        @{ Name = "empty-list-read-as-missing"
           Find = 'Write-Output -NoEnumerate $p.Value'
           Replace = 'return $p.Value' }
        @{ Name = "bom-accepted"
           Find = '$Bytes[2] -eq 0xBF) { throw'
           Replace = '$Bytes[2] -eq 0x00) { throw' }
        @{ Name = "non-ascii-accepted"
           Find = 'if ($b -gt 0x7F) { throw'
           Replace = 'if ($b -gt 0xFF) { throw' }
        @{ Name = "duplicate-key-ignored"
           Find = 'return @(@(Find-HordeJsonDuplicateKey -Text $Text) |'
           Replace = 'return @(@() |' }
        @{ Name = "schema-skipped"
           Find = '@(Test-HordeSchema -Value $d -Schema (Get-HordeSchema -Name "agent-descriptor.v1"))'
           Replace = '@()' }
        @{ Name = "name-not-checked-against-folder"
           Find = '$name -cne $ExpectedName'
           Replace = '$false' }
        @{ Name = "empty-protocols-accepted"
           Find = 'if (@($protocols).Count -eq 0) {'
           Replace = 'if ($false) {' }
        @{ Name = "repeated-protocol-accepted"
           Find = 'if (-not $seenP.Add("$p"))'
           Replace = 'if ($false)' }
        @{ Name = "unanchored-pattern-accepted"
           Find = 'if ($compiled -and -not ($startsAnchored -and $endsAnchored))'
           Replace = 'if ($false)' }
        @{ Name = "start-anchor-enough"
           Find = '-not ($startsAnchored -and $endsAnchored)'
           Replace = '-not ($startsAnchored)' }
        @{ Name = "compile-failure-unnamed"
           Find = '"the sessionIdPattern does not compile: " + $_.Exception.InnerException.Message'
           Replace = '"bad pattern"' }
        @{ Name = "owned-variables-compared-with-case"
           Find = '[System.StringComparer]::OrdinalIgnoreCase)'
           Replace = '[System.StringComparer]::Ordinal)' }
        @{ Name = "supported-event-needs-no-hook"
           Find = '-and $hook -isnot [string]) {'
           Replace = '-and $false) {' }
        @{ Name = "lacking-event-may-name-hook"
           Find = 'if ($null -ne $hook) { [void]$out.Add("the event "'
           Replace = 'if ($false) { [void]$out.Add("the event "' }
        @{ Name = "capability-list-not-compared-with-vocabulary"
           Find = 'foreach ($w in $want) { if ($have -cnotcontains $w)'
           Replace = 'foreach ($w in @()) { if ($have -cnotcontains $w)'
           Expect = "survives"
           Reason = "Defence in depth: the schema lists the same capability names as required, and test-agent-descriptor checks the schema's list equals the vocabulary's, so while both agree the schema refuses first. The rule exists for the day one of them changes alone." }
        @{ Name = "missing-folder-descriptor-ignored"
           Find = '[void]$problems.Add("the harness folder " + $dir.Name + " has no agent.json"); continue'
           Replace = 'continue' }
        @{ Name = "bad-descriptor-dropped-from-list"
           Find = 'catch { [void]$problems.Add($_.Exception.Message) }'
           Replace = 'catch { }' }
        @{ Name = "unverified-satisfies-requirement"
           Find = 'return [bool]("$($row.support)" -ceq "yes")'
           Replace = 'return [bool]("$($row.support)" -cne "no")' }
        @{ Name = "unverified-answered-plain-no"
           Find = 'return (New-HordeUnknown -Reason ($Name + " is unverified for "'
           Replace = 'return (New-HordeKnown -Value $false); return (New-HordeUnknown -Reason ($Name + " is unverified for "' }
        @{ Name = "unverified-answered-yes"
           Find = 'if ($support -ceq "yes") { return (New-HordeKnown -Value $true) }'
           Replace = 'if ($support -ceq "yes" -or $support -ceq "unverified") { return (New-HordeKnown -Value $true) }' }
        @{ Name = "declined-answered-unknown"
           Find = 'if ($support -ceq "no" -or $support -ceq "declined")'
           Replace = 'if ($support -ceq "no")' }
        @{ Name = "vocabulary-host-not-checked"
           Find = '$script:HordeHostCapabilityNames -cnotcontains $hostName'
           Replace = '$false' }
        @{ Name = "vocabulary-repeat-accepted"
           Find = 'elseif (-not $seen.Add($name))'
           Replace = 'elseif ($false)' }
        @{ Name = "vocabulary-port-not-checked"
           Find = '$script:HordeCapabilityPorts -cnotcontains $port'
           Replace = '$false' }
        @{ Name = "vocabulary-agent-row-may-name-host"
           Find = 'if ($null -ne $hostName) { [void]$problems.Add($at + " is satisfied only by an agent'
           Replace = 'if ($false) { [void]$problems.Add($at + " is satisfied only by an agent' }
        @{ Name = "vocabulary-flag-in-meaning-accepted"
           Find = 'elseif ($meaning -cmatch $script:HordeCapabilityFlagPattern)'
           Replace = 'elseif ($false)' }
    )
}
