# Mutations of the stored session record. Run: powershell -File tools\Mutate.ps1 -Spec test\mutations\session-record.psd1
# The schema is the thing under test, so it is the target: each mutation loosens, removes or
# mislabels one rule in its text, and test\test-schema-session-record.ps1 must fail for every one.
@{
    Target = "schema\session-record.v1.json"
    Suite  = "test\test-schema-session-record.ps1"
    Mutations = @(
        @{ Name = "unknown-keys-allowed"
           Find = '"additionalProperties": false,'
           Replace = '"additionalProperties": true,' }
        @{ Name = "session-id-not-required"
           Find = '"required": ["schemaVersion", "sessionId", "device"],'
           Replace = '"required": ["schemaVersion", "device"],' }
        @{ Name = "session-id-any-string"
           Find = '"sessionId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", '
           Replace = '"sessionId": { "type": "string", ' }
        @{ Name = "schema-version-2-accepted"
           Find = '"enum": [1],'
           Replace = '"enum": [1, 2],' }
        @{ Name = "role-accepts-old-vocabulary"
           Find = '"enum": ["warchief", "orc", "warg"],'
           Replace = '"enum": ["warchief", "orc", "warg", "master", "orchestrator", "session"],' }
        @{ Name = "role-any-string"
           Find = '"role": { "type": "string", "enum": ["warchief", "orc", "warg"], '
           Replace = '"role": { "type": "string", ' }
        @{ Name = "parent-any-string"
           Find = '"parent": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", '
           Replace = '"parent": { "type": "string", ' }
        @{ Name = "label-any-case"
           Find = '"pattern": "^[A-Z]{1,2}([1-9][0-9]{0,3})?$"'
           Replace = '"pattern": "^[A-Za-z]{1,2}([1-9][0-9]{0,3})?$"' }
        @{ Name = "label-number-may-start-with-zero"
           Find = '"pattern": "^[A-Z]{1,2}([1-9][0-9]{0,3})?$"'
           Replace = '"pattern": "^[A-Z]{1,2}([0-9][0-9]{0,3})?$"' }
        @{ Name = "label-number-any-length"
           Find = '"pattern": "^[A-Z]{1,2}([1-9][0-9]{0,3})?$"'
           Replace = '"pattern": "^[A-Z]{1,2}([1-9][0-9]*)?$"' }
        @{ Name = "origin-any-string"
           Find = '"origin": { "type": "string", "enum": ["fleet", "user"], '
           Replace = '"origin": { "type": "string", ' }
        @{ Name = "fleet-session-id-may-be-empty"
           Find = '"fleetSessionId": { "type": "string", "pattern": "\\S", '
           Replace = '"fleetSessionId": { "type": "string", ' }
        @{ Name = "device-not-required"
           Find = '"required": ["schemaVersion", "sessionId", "device"],'
           Replace = '"required": ["schemaVersion", "sessionId"],' }
        @{ Name = "device-any-string"
           Find = '"device": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", '
           Replace = '"device": { "type": "string", ' }
        @{ Name = "device-any-case"
           Find = '"device": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", '
           Replace = '"device": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$", ' }
        @{ Name = "device-written-by-the-node"
           Find = '"x-horde-owner": "engine", "description": "WHERE THE SESSION RUNS'
           Replace = '"x-horde-owner": "node", "description": "WHERE THE SESSION RUNS' }
        @{ Name = "device-dropped"
           Find = '"device": { "type": "string"'
           Replace = '"deviceName": { "type": "string"' }
        @{ Name = "id-of-another-schema"
           Find = '"$id": "horde/schema/session-record.v1",'
           Replace = '"$id": "horde/schema/session-binding.v1",' }
        @{ Name = "observed-field-back-in-the-fleet-record"
           Find = '"properties": {'
           Replace = '"properties": { "lastSeen": { "type": "string", "x-horde-owner": "engine", "x-horde-read": "W1 lastSeen" },' }
        @{ Name = "node-field-back-in-the-fleet-record"
           Find = '"properties": {'
           Replace = '"properties": { "projectCwd": { "type": "string", "pattern": "\\S", "x-horde-owner": "engine", "x-horde-read": "X2 cwd, then W1 firstCwd, then X1 cwd, then W1 cwd" },' }
        @{ Name = "retired-as-string"
           Find = '"retired": { "type": "boolean",'
           Replace = '"retired": { "type": "string",' }
        @{ Name = "retired-at-any-zone"
           Find = '"retiredAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"'
           Replace = '"retiredAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z?$"' }
        @{ Name = "run-id-any-string"
           Find = '"runId": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[a-z0-9-]+$", '
           Replace = '"runId": { "type": "string", ' }
        @{ Name = "label-cycle-any-type"
           Find = '"labelCycle": { "type": "integer", '
           Replace = '"labelCycle": { ' }
        @{ Name = "title-any-type"
           Find = '"title": { "type": "string", "pattern": "\\S", '
           Replace = '"title": { ' }
        @{ Name = "depends-on-as-string"
           Find = '"dependsOn": { "type": "array", "items": { "type": "string", "pattern": "\\S" }, '
           Replace = '"dependsOn": { "type": "string", ' }
        @{ Name = "depends-on-items-unchecked"
           Find = '"items": { "type": "string", "pattern": "\\S" }, '
           Replace = '' }
        @{ Name = "schema-version-not-required"
           Find = '"required": ["schemaVersion", "sessionId", "device"],'
           Replace = '"required": ["sessionId", "device"],' }
        @{ Name = "session-id-start-unanchored"
           Find = '"sessionId": { "type": "string", "pattern": "^[0-9a-fA-F]{8}'
           Replace = '"sessionId": { "type": "string", "pattern": "[0-9a-fA-F]{8}' }
        @{ Name = "session-id-end-unanchored"
           Find = '[0-9a-fA-F]{12}$", "x-horde-owner": "agent"'
           Replace = '[0-9a-fA-F]{12}", "x-horde-owner": "agent"' }
        @{ Name = "parent-start-unanchored"
           Find = '"parent": { "type": "string", "pattern": "^[0-9a-fA-F]{8}'
           Replace = '"parent": { "type": "string", "pattern": "[0-9a-fA-F]{8}' }
        @{ Name = "parent-end-unanchored"
           Find = '[0-9a-fA-F]{12}$", "x-horde-owner": "engine", "x-horde-read": "W1 parent'
           Replace = '[0-9a-fA-F]{12}", "x-horde-owner": "engine", "x-horde-read": "W1 parent' }
        @{ Name = "origin-accepts-empty"
           Find = '"enum": ["fleet", "user"],'
           Replace = '"enum": ["fleet", "user", ""],' }
        @{ Name = "run-id-slug-any-text"
           Find = '"pattern": "^[0-9]{8}-[0-9]{6}-[a-z0-9-]+$"'
           Replace = '"pattern": "^[0-9]{8}-[0-9]{6}-.+$"' }
        @{ Name = "label-tail-any-capitals-and-digits"
           Find = '"pattern": "^[A-Z]{1,2}([1-9][0-9]{0,3})?$"'
           Replace = '"pattern": "^[A-Z]{1,2}[0-9A-Z]*$"' }
        @{ Name = "depends-on-items-may-be-empty"
           Find = '"items": { "type": "string", "pattern": "\\S" }'
           Replace = '"items": { "type": "string" }' }
        @{ Name = "title-may-be-empty"
           Find = '"title": { "type": "string", "pattern": "\\S", '
           Replace = '"title": { "type": "string", ' }
        @{ Name = "stored-field-renamed"
           Find = '"retiredAt": { "type": "string"'
           Replace = '"retireAt": { "type": "string"' }
        @{ Name = "agent-field-stored"
           Find = '"properties": {'
           Replace = '"properties": { "pid": { "type": "integer", "x-horde-owner": "agent" },' }
        @{ Name = "derived-field-stored"
           Find = '"properties": {'
           Replace = '"properties": { "owner": { "type": "string", "x-horde-owner": "engine", "x-horde-read": "W1 owner, then W2 owner" },' }
        @{ Name = "stored-field-names-another-owner"
           Find = '"x-horde-owner": "engine", "x-horde-read": "W1 label, then W2 label"'
           Replace = '"x-horde-owner": "agent", "x-horde-read": "W1 label, then W2 label"' }
        @{ Name = "read-order-documented-wrong"
           Find = '"x-horde-read": "W1 role, then W2 role"'
           Replace = '"x-horde-read": "W2 role, then W1 role"' }
        @{ Name = "session-id-owner-changed"
           Find = '"x-horde-owner": "agent", "description": "THE KEY'
           Replace = '"x-horde-owner": "engine", "description": "THE KEY' }
        @{ Name = "key-repeated-in-text"
           Find = '"properties": {'
           Replace = '"properties": { "role": { "type": "string", "enum": ["warchief", "orc", "warg"], "x-horde-owner": "engine", "x-horde-read": "W1 role, then W2 role" },' }
        @{ Name = "label-cycle-negative-allowed"
           Find = '"labelCycle": { "type": "integer", "minimum": 0,'
           Replace = '"labelCycle": { "type": "integer",' }
        @{ Name = "label-cycle-minimum-one"
           Find = '"labelCycle": { "type": "integer", "minimum": 0,'
           Replace = '"labelCycle": { "type": "integer", "minimum": 1,' }
    )
}
